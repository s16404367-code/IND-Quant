{
  "name": "indian-options-quant-risk-terminal-v4",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "IND-QUANT \u2014 Indian Options Research & Risk Lab (education only, keyless public NSE end-of-day data, no order execution)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && node scripts/prepare-branch-site.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "bridge": "node services/local-bridge/server.mjs",
    "data": "node scripts/fetch-market-data.mjs && node scripts/pack-data-snapshot.mjs",
    "legal": "node scripts/export-legal-md.mjs",
    "predev": "node scripts/restore-data-snapshot.mjs",
    "prebuild": "node scripts/restore-data-snapshot.mjs",
    "data:restore": "node scripts/restore-data-snapshot.mjs --force"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
